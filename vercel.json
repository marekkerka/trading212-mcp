{
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/metadata?doc=resource" },
    { "source": "/.well-known/oauth-protected-resource/(.*)", "destination": "/api/metadata?doc=resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/metadata?doc=as" },
    { "source": "/.well-known/oauth-authorization-server/(.*)", "destination": "/api/metadata?doc=as" },
    { "source": "/.well-known/openid-configuration", "destination": "/api/metadata?doc=as" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/authorize", "destination": "/api/authorize" },
    { "source": "/token", "destination": "/api/token" },
    { "source": "/register", "destination": "/api/register" },
    { "source": "/", "destination": "/api/metadata?doc=as" }
  ]
}
